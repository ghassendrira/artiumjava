<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CourseController">
    <!-- Marges autour du conteneur -->
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Titre de l'interface -->
    <Label styleClass="title-label" text="Catégories et Cours" />

    <!-- TreeView pour afficher les catégories -->
    <TreeView fx:id="categoryTreeView" prefHeight="450.0" prefWidth="250.0" styleClass="category-tree" />

    <!-- Style CSS -->
    <stylesheets>
        <URL value="@/style.css" />
    </stylesheets>
</VBox>
